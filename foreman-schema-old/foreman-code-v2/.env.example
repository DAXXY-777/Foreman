# Copy this file to .env and put your own key in it. .env is never committed.
NVIDIA_API_KEY=paste-your-key-here
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_PRIMARY_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_BACKUP_MODEL=openai/gpt-oss-20b
# Requests per minute allowed by the client (lower it if you see 429 errors)
LLM_RPM=40

# Database. Leave these out to use the local Docker database. For FalkorDB Cloud, fill them in:
# FALKORDB_HOST=your-database.falkordb.cloud
# FALKORDB_PORT=12345
# FALKORDB_USERNAME=default
# FALKORDB_PASSWORD=paste-database-password-here
# FALKORDB_SSL=true
